{
  "manifest_version": 3,
  "name": "Quiz Autofill",
  "version": "1.1",
  "content_scripts": [
    {
      "matches": ["*://*/mod/quiz/attempt.php*"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "quiz-autofill@example.com",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}